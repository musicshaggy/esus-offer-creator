{
  "name": "esus-quote-generator",
  "version": "2.1.0",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test tests/*.test.cjs",
    "invoice:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-invoice.ps1",
    "prestart": "npm run invoice:prepare",
    "prepack": "npm run invoice:prepare",
    "predist": "npm run invoice:prepare"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "electron-updater": "^6.4.0"
  },
  "build": {
    "appId": "pl.esus.app",
    "productName": "ESUS IT Offer Generator",
    "asar": true,
    "files": [
      "main.js",
      "background/**/*",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "invoice-ipc.js"
    ],
    "win": {
      "icon": "build/favicon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "musicshaggy",
        "repo": "esus-offer-creator",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "invoice",
        "to": "invoice",
        "filter": [
          "**/*",
          "!test_*.py",
          "!__pycache__/**/*"
        ]
      },
      {
        "from": "runtime/python",
        "to": "python"
      },
      {
        "from": "renderer/assets/document-design.json",
        "to": "invoice/document-design.json"
      },
      {
        "from": "renderer/assets/fonts",
        "to": "invoice/fonts",
        "filter": [
          "Inter-*"
        ]
      },
      {
        "from": "renderer/assets/logo_1_big.png",
        "to": "invoice/logo_1_big.png"
      }
    ]
  }
}
